 "templates": [
  {
   "lsr": 1,
   "text": "If a worker is in a machine-guard-zone for at least 5 seconds then VisionGuard raises a critical bypassing-safety-controls-alert for the worker."
  },
  {
   "lsr": 2,
   "text": "If a worker is in a confined-space and does not carry a gas-detector for at least 10 seconds then VisionGuard raises a critical confined-space-alert for the worker."
  },
  {
   "lsr": 3,
   "text": "If a worker drives a vehicle and uses a phone for at least 3 seconds then VisionGuard raises a critical driving-alert for the worker."
  },
  {
   "lsr": 4,
   "text": "If a worker is in a live-equipment-zone and the live-equipment-zone does not have an isolation-certificate for at least 5 seconds then VisionGuard raises a critical energy-isolation-alert for the worker."
  },
  {
   "lsr": 5,
   "text": "If a flame is in a hot-work-area and the hot-work-area does not have a permit for at least 5 seconds then VisionGuard raises a critical hot-work-alert."
  },
  {
   "lsr": 6,
   "text": "If a worker is under a suspended-load for at least 2 seconds then VisionGuard raises a critical line-of-fire-alert for the worker."
  },
  {
   "lsr": 7,
   "text": "If at least 3 workers are in a lifting-zone for at least 5 seconds then VisionGuard raises a high mechanical-lifting-alert."
  },
  {
   "lsr": 8,
   "text": "If a worker is in a restricted-area and the restricted-area does not have a permit for at least 30 seconds then VisionGuard raises a high work-authorisation-alert for the worker."
  },
  {
   "lsr": 9,
   "text": "If a worker is in a height-zone and does not wear a harness for at least 3 seconds then VisionGuard raises a critical working-at-height-alert for the worker."
  }
 ],
